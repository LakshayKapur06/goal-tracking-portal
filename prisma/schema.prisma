generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Auth.js Models (NextAuth)
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          String    @default("EMPLOYEE") // EMPLOYEE, MANAGER, ADMIN
  
  // Self-relation for reporting hierarchy
  managerId     String?
  manager       User?     @relation("ManagerToEmployee", fields: [managerId], references: [id])
  employees     User[]    @relation("ManagerToEmployee")

  accounts      Account[]
  sessions      Session[]
  goals         Goal[]
  auditLogs     AuditLog[]
  notifications NotificationLog[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Application Models
model Goal {
  id          String   @id @default(cuid())
  employeeId  String
  employee    User     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  
  title       String
  description String?
  thrustArea  String
  uomType     String   // MIN, MAX, TIMELINE, ZERO
  target      String   // Can be numeric or date string
  weightage   Float
  status      String   @default("DRAFT") // DRAFT, PENDING_APPROVAL, APPROVED, REJECTED, LOCKED
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  checkIns    CheckIn[]
  auditLogs   AuditLog[]
}

model SharedGoal {
  id        String   @id @default(cuid())
  adminId   String
  title     String
  target    String
  createdAt DateTime @default(now())
}

model CheckIn {
  id                String   @id @default(cuid())
  goalId            String
  goal              Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  
  quarter           String   // Q1, Q2, Q3, Q4
  actualAchievement String?
  progressStatus    String   @default("NOT_STARTED") // NOT_STARTED, ON_TRACK, COMPLETED
  managerComment    String?
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([goalId, quarter])
}

model AuditLog {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  action       String
  targetEntity String   // e.g., 'Goal'
  targetId     String?  // The ID of the affected entity
  goalId       String?
  goal         Goal?    @relation(fields: [goalId], references: [id])
  changes      String   // JSON stringified
  timestamp    DateTime @default(now())
}

model NotificationLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String   // EMAIL, TEAMS
  message   String
  status    String   // PENDING, SENT, FAILED
  timestamp DateTime @default(now())
}

model CycleWindow {
  id        String   @id @default(cuid())
  phase     String   @unique
  status    String   @default("UPCOMING")
  updatedAt DateTime @updatedAt
}
